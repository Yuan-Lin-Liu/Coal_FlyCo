# Source this file from the onboard user's ~/.bashrc.
flyco_onboard_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"

source /opt/ros/humble/setup.bash
if [[ -f "$flyco_onboard_root/install/setup.bash" ]]; then
  source "$flyco_onboard_root/install/setup.bash"
fi

export COAL_FLYCO_ROOT="$flyco_onboard_root"
export ROS_DOMAIN_ID=3
export ROS_LOCALHOST_ONLY=0
export RMW_IMPLEMENTATION=rmw_fastrtps_cpp
unset FASTDDS_DEFAULT_PROFILES_FILE
if [[ -r "$flyco_onboard_root/.local/deploy/fastdds-orin.xml" ]]; then
  export FASTRTPS_DEFAULT_PROFILES_FILE="$flyco_onboard_root/.local/deploy/fastdds-orin.xml"
else
  unset FASTRTPS_DEFAULT_PROFILES_FILE
fi
export ORIN_IP=192.168.8.204
export GROUND_IP=192.168.8.181

case ":${LD_LIBRARY_PATH:-}:" in
  *":$flyco_onboard_root/.local/deploy/embree3/lib:"*) ;;
  *) export LD_LIBRARY_PATH="$flyco_onboard_root/.local/deploy/embree3/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" ;;
esac
case ":${CMAKE_PREFIX_PATH:-}:" in
  *":$flyco_onboard_root/.local/deploy/embree3:"*) ;;
  *) export CMAKE_PREFIX_PATH="$flyco_onboard_root/.local/deploy/embree3${CMAKE_PREFIX_PATH:+:$CMAKE_PREFIX_PATH}" ;;
esac
if [[ -f /usr/lib/aarch64-linux-gnu/cmake/opencv4/OpenCVConfig.cmake ]]; then
  export OpenCV_DIR=/usr/lib/aarch64-linux-gnu/cmake/opencv4
fi

for flyco_onboard_host in localhost 127.0.0.1 "$GROUND_IP" "$ORIN_IP"; do
  case ",${no_proxy:-}," in
    *",$flyco_onboard_host,"*) ;;
    *) no_proxy="${no_proxy:+$no_proxy,}$flyco_onboard_host" ;;
  esac
done
export no_proxy
export NO_PROXY="$no_proxy"

if [[ -r "$flyco_onboard_root/.local/deploy/semantic.env" ]]; then
  source "$flyco_onboard_root/.local/deploy/semantic.env"
fi

unset flyco_onboard_host flyco_onboard_root
