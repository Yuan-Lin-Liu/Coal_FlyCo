FROM python:3.12-slim
ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1 PIP_DISABLE_PIP_VERSION_CHECK=1
RUN python -m pip install --timeout 40 --retries 12 --index-url https://download.pytorch.org/whl/cu128 torch==2.7.1 torchvision==0.22.1
COPY requirements-server.txt /tmp/requirements-server.txt
RUN sed -i 's/^opencv-python==/opencv-python-headless==/' /tmp/requirements-server.txt \
    && python -m pip install --timeout 40 --retries 12 --index-url https://pypi.org/simple -r /tmp/requirements-server.txt
WORKDIR /app
ENV HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 NVIDIA_DRIVER_CAPABILITIES=compute,utility
CMD ["python", "-B", "-m", "sam_ad.server", "--backend", "A", "--bind", "127.0.0.1", "--port", "8850"]
