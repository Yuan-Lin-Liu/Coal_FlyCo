ARG ROS_IMAGE=ubuntu:22.04
FROM nvidia/cuda:11.8.0-devel-ubuntu20.04 AS cuda
FROM ${ROS_IMAGE}
USER root
COPY --from=cuda /usr/local/cuda-11.8 /usr/local/cuda-11.8
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ARG DEBIAN_FRONTEND=noninteractive
ARG TORCH_CUDA_ARCH_LIST=8.6
ARG BUILD_JOBS=4
ARG NKSR_REVISION=e40336845e67761343a756788e5a98b827d4a143
ENV LANG=C.UTF-8 LC_ALL=C.UTF-8 \
    FLYCO_RUNTIME=/opt/flyco-runtime FLYCO_MODELS=/models \
    CUDA_HOME=/usr/local/cuda-11.8 FLYCO_CUDA_HOME=/usr/local/cuda-11.8 \
    TORCH_CUDA_ARCH_LIST=${TORCH_CUDA_ARCH_LIST} MAX_JOBS=2 \
    FLYCO_SAM_SOURCE=/opt/flyco-runtime/python \
    PYTHONDONTWRITEBYTECODE=1 PYTHONNOUSERSITE=1
RUN apt-get update && apt-get install -y --no-upgrade -o Acquire::Retries=5 --no-install-recommends \
    ca-certificates curl gnupg git build-essential gcc-11 g++-11 cmake \
    python3-dev python3-pip python3-venv python3-opencv python3-yaml \
    libeigen3-dev libpcl-dev libompl-dev libyaml-cpp-dev libtbb-dev \
    libgl1 libglib2.0-0 libxcb-xinerama0 libxkbcommon-x11-0 \
    libxrender1 libsm6 ffmpeg ninja-build \
    && if ! grep -Rqs 'packages.ros.org/ros2/ubuntu' /etc/apt/sources.list.d; then \
      curl -fsSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
        -o /usr/share/keyrings/ros-archive-keyring.gpg; \
      echo 'deb [arch=amd64 signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] https://packages.ros.org/ros2/ubuntu jammy main' \
        > /etc/apt/sources.list.d/ros2.list; fi \
    && find /etc/apt/sources.list.d -type f -exec sed -i 's|http://packages.ros.org|https://packages.ros.org|g' {} + \
    && apt-get update && apt-get install -y --no-upgrade -o Acquire::Retries=5 --no-install-recommends \
      ros-humble-ros-base ros-humble-rviz2 ros-humble-cv-bridge \
      ros-humble-mavros-msgs ros-humble-geographic-msgs \
      ros-humble-image-transport ros-humble-message-filters \
      ros-humble-pcl-conversions ros-humble-tf2-geometry-msgs \
      ros-humble-tf2-sensor-msgs ros-humble-rosgraph-msgs \
      python3-colcon-common-extensions \
    && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv --system-site-packages "$FLYCO_RUNTIME/venv" \
    && "$FLYCO_RUNTIME/venv/bin/python" -m pip install --no-cache-dir 'pip<25' 'setuptools<70' wheel \
    && "$FLYCO_RUNTIME/venv/bin/python" -m pip install --no-cache-dir \
      torch==2.3.1 torchvision==0.18.1 --index-url https://download.pytorch.org/whl/cu118
COPY docker/requirements.txt /tmp/requirements.txt
RUN "$FLYCO_RUNTIME/venv/bin/python" -m pip install --no-cache-dir -r /tmp/requirements.txt \
    && "$FLYCO_RUNTIME/venv/bin/python" -m pip install --no-cache-dir --no-index --no-deps \
      -f https://data.pyg.org/whl/torch-2.3.0+cu118.html torch-scatter==2.1.2+pt23cu118
ENV PATH=/opt/flyco-runtime/venv/bin:/usr/local/cuda-11.8/bin:${PATH}
RUN git init /tmp/NKSR \
    && git -C /tmp/NKSR remote add origin https://github.com/nv-tlabs/NKSR.git \
    && git -C /tmp/NKSR fetch --depth 1 origin "$NKSR_REVISION" \
    && git -C /tmp/NKSR checkout FETCH_HEAD \
    && git init /tmp/NKSR/package/external/openvdb \
    && git -C /tmp/NKSR/package/external/openvdb remote add origin https://github.com/AcademySoftwareFoundation/openvdb.git \
    && git -C /tmp/NKSR/package/external/openvdb fetch --depth 1 origin 7edd8cd86f105a01a41ad7b2bf59a81034cd79fb \
    && git -C /tmp/NKSR/package/external/openvdb checkout FETCH_HEAD \
    && git clone --depth 1 --branch 3.4 https://gitlab.com/libeigen/eigen.git /tmp/NKSR/package/external/eigen \
    && python -m pip install --no-cache-dir --no-build-isolation /tmp/NKSR/package \
    && rm -rf /tmp/NKSR
WORKDIR /workspace/coal_flyco
COPY . .
RUN ./tools/setup_flyco.sh \
    && python -m pip install --no-cache-dir --no-build-isolation --no-deps \
      third_party/flyco_ros2/vendor/perception_predictor/src/sam_tracking/thirdparty/sam2-realtime \
    && mkdir -p "$FLYCO_RUNTIME/python" \
    && cp -a "$FLYCO_RUNTIME/venv/lib/python3.10/site-packages/sam2" "$FLYCO_RUNTIME/python/" \
    && source tools/flyco_env.sh \
    && python -c 'import pointnet2_ops, sam2, sam2._C, nksr; print("GPU extensions built")'
# These Python ROS modules are used by mesh prediction and point cloud IO.
RUN apt-get update && apt-get install -y --no-upgrade -o Acquire::Retries=5 --no-install-recommends \
      ros-humble-image-geometry ros-humble-sensor-msgs-py \
    && rm -rf /var/lib/apt/lists/*
# Containers run as the invoking user's UID. Build products are read-only;
# per-user logs and model caches are mounted by tools/container_runtime.py.
RUN chmod -R a+rX /opt/flyco-runtime /workspace/coal_flyco \
    && mkdir -p /home/coal && chmod 1777 /home/coal
ENV HOME=/home/coal \
    POINTNET2_OPS_EXTENSION_PATH=/opt/flyco-runtime/cache/torch_extensions/py310_cu118/_ext/_ext.so
LABEL org.opencontainers.image.source="https://github.com/Yuan-Lin-Liu/Coal_FlyCo"
ENTRYPOINT []
CMD ["bash"]
